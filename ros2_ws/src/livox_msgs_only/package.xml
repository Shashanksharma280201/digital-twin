<?xml version="1.0"?>
<package format="3">
  <!-- Message definitions of livox_ros_driver2 only, for machines without a Mid-360 (Airy-only rigs).
       FAST-LIO and dt_lidar_bridge include livox_ros_driver2/msg/CustomMsg at compile time.
       Use either this package or the real driver in src/external (COLCON_IGNORE the other). -->
  <name>livox_ros_driver2</name>
  <version>1.0.0</version>
  <description>Livox CustomMsg/CustomPoint definitions only (no driver, no Livox-SDK2).</description>
  <maintainer email="shashank.sharma.280201@gmail.com">Shashank Sharma</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
